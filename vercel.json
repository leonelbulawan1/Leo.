{
  "rewrites": [
    { "source": "/api/visits", "destination": "https://leonelbulawan.goatcounter.com/counter/TOTAL.json" }
  ],
  "headers": [
    { "source": "/api/visits", "headers": [ { "key": "Cache-Control", "value": "public, max-age=60" } ] },
    {
      "source": "/Leonel-Bulawan-Portfolio-QR.png",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Leonel-Bulawan-Portfolio-QR.png\"" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
